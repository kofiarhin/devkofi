#!/bin/bash
# Root-owned sudo target that devkofi-deploy may run as ubuntu, only as "check" or
# "deploy <sha> [<ci-run-id>]" (see sudoers.devkofi-deploy). Template only: Phase 2
# installs it as /usr/local/sbin/devkofi-deploy-run.
#
# It releases only from the private checkout /home/ubuntu/deploy/devkofi, never from
# /home/ubuntu/projects/devkofi: beast-agent can write there, and ubuntu has full sudo,
# so running that checkout's code as ubuntu would hand beast-agent root. It refuses any
# commit that is not the current origin/main, re-checks CI with the already deployed
# gate, fast-forwards, then runs deploy.sh detached so a dropped SSH session cannot
# interrupt a release halfway. The caller sees only "[deploy]"/"[ci-gate]" lines because
# this repository's Actions logs are public; the full log stays on Beast.
set -Eeuo pipefail
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin HOME=/home/ubuntu

BASE=/home/ubuntu/deploy
REPO=$BASE/devkofi
STATE=$BASE/devkofi-automation
RUN_USER=ubuntu
KEEP_LOGS=30

say() { printf '[deploy] %s\n' "$*"; }
refuse() { local code="$1"; shift; printf '[deploy] REFUSED: %s\n' "$*" >&2; exit "$code"; }
# Nobody but RUN_USER may enter BASE, and nobody else may replace it via an ancestor.
# Root-owned sticky directories (such as /tmp) are safe ancestors.
private_base() {
  local dir="$BASE" mode owner
  [[ -d "$BASE" && ! -L "$BASE" && "$(stat -c '%U %a' "$BASE")" == "$RUN_USER 700" ]] || return 1
  [[ "$(ls -ld "$BASE" | cut -c11)" != + ]] || return 1
  while [[ "$dir" != / ]]; do
    dir="$(dirname "$dir")"
    read -r owner mode < <(stat -c '%U %a' "$dir")
    [[ "$owner" == root || "$owner" == "$RUN_USER" ]] || return 1
    [[ "$owner" == root && ${#mode} -eq 4 && "${mode:0:1}" =~ [1357] ]] && continue
    (( (8#$mode & 8#022) == 0 )) || return 1
  done
}

[[ "$(id -un)" == "$RUN_USER" ]] || refuse 77 "must run as $RUN_USER"
mode="${1:-}"
sha=""
ci_run=""
case "$mode" in
  check) [[ $# -eq 1 ]] || refuse 64 "usage: check | deploy <sha> [<ci-run-id>]" ;;
  deploy)
    [[ ($# -eq 2 || $# -eq 3) && "$2" =~ ^[0-9a-f]{40}$ ]] || refuse 64 "usage: deploy <40-hex-sha> [<ci-run-id>]"
    sha="$2"
    if [[ $# -eq 3 ]]; then
      [[ "$3" =~ ^[1-9][0-9]{0,19}$ ]] || refuse 64 "invalid CI run id"
      ci_run="$3"
    fi
    ;;
  *) refuse 64 "usage: check | deploy <sha> [<ci-run-id>]" ;;
esac

private_base || refuse 66 "$BASE must be owned by $RUN_USER, mode 700, without ACLs or writable ancestors"
mkdir -p -m 700 "$STATE/logs"
[[ ! -L "$STATE" && ! -L "$STATE/logs" ]] || refuse 66 "unsafe state directory"
# Both locks are inherited by the detached deployment, so they stay held until it ends.
# Lock contention is a failure (73), not a skip: the newer commit still needs releasing.
exec 8>"$STATE/run.lock"
flock -n 8 || refuse 73 "another DevKofi deployment request is running"
# Shared with deploy.sh, so manual releases and this wrapper never touch the checkout at once.
HOST_LOCK=/home/ubuntu/.devkofi-deploy.lock
[[ ! -L "$HOST_LOCK" ]] || refuse 66 "unsafe host lock"
exec 7>>"$HOST_LOCK"
flock -n 7 || refuse 73 "a DevKofi release is already running"

# Defence in depth: ignore system/global Git config, replace refs, hooks and fsmonitor.
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_NO_REPLACE_OBJECTS=1 GIT_TERMINAL_PROMPT=0 \
  GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=/dev/null \
  GIT_CONFIG_KEY_1=core.fsmonitor GIT_CONFIG_VALUE_1=false
# The CI gate runs anonymously against the public API.
unset GITHUB_TOKEN GITHUB_ACTIONS
cd "$REPO"
[[ "$(git branch --show-current)" == main ]] || refuse 66 "checkout is not on main"
[[ -z "$(git status --porcelain)" ]] || refuse 66 "checkout has uncommitted changes"
git fetch --quiet origin main || refuse 69 "could not fetch origin/main"
remote="$(git rev-parse refs/remotes/origin/main)"
# deploy.sh is about to run from this checkout, so it must hold only GitHub commits.
git merge-base --is-ancestor HEAD "$remote" || refuse 66 "local main has commits that are not on GitHub"

args=(--check)
if [[ "$mode" == deploy ]]; then
  [[ "$sha" == "$remote" ]] || refuse 75 "${sha:0:12} is not the current origin/main (${remote:0:12}); outdated commit skipped"
  # Gate with the already deployed checker before any new commit's code runs here.
  gate=(--sha "$sha")
  [[ -z "$ci_run" ]] || gate+=(--run-id "$ci_run")
  node scripts/check-ci.cjs "${gate[@]}" || exit $?
  # Changes to the release tooling itself are never applied unattended (spec section 6):
  # an operator releases them once by hand, after which automation resumes.
  if [[ -n "$(git diff --name-only HEAD "$sha" -- compose.yaml scripts/deploy.sh scripts/deploy.conf scripts/deploy-compose-label.sh scripts/check-ci.cjs)" ]]; then
    refuse 76 "${sha:0:12} changes deployment tooling; release it manually (docs/deployment/beast-docker.md)"
  fi
  git merge --quiet --ff-only "$sha" || refuse 66 "could not fast-forward to ${sha:0:12}"
  export DEVKOFI_EXPECTED_SHA="$sha"
  [[ -z "$ci_run" ]] || export DEVKOFI_CI_RUN_ID="$ci_run"
  args=()
fi

log="$STATE/logs/$(date -u +%Y%m%dT%H%M%SZ)-$mode${sha:+-${sha:0:12}}.log"
say "Starting $mode${sha:+ for ${sha:0:12}} (full log on Beast: $log)"
# Create the log before tail opens it; otherwise tail can start first and miss it.
: >"$log"
setsid -w bash "$REPO/scripts/deploy.sh" "${args[@]}" </dev/null >>"$log" 2>&1 &
pid=$!
tail -n +1 --pid="$pid" -f "$log" | grep --line-buffered -E '^\[(deploy|ci-gate)\]' || true
rc=0
wait "$pid" || rc=$?

find "$STATE/logs" -maxdepth 1 -type f -name '*.log' -printf '%T@ %p\n' \
  | sort -rn | tail -n +"$((KEEP_LOGS + 1))" | cut -d' ' -f2- | xargs -r rm -f --
if [[ $rc -ne 0 ]]; then
  say "FINISHED with exit $rc; see $log on Beast"
fi
exit "$rc"
